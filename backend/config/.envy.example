# ===========================================
# 童话镇系统配置文件
# 复制此文件为 .env 并填入真实值
# ===========================================

# ========== API 配置 ==========
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ========== 系统配置 ==========
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here

# ========== 记忆配置 ==========
DEFAULT_MEMORY_LEN=10
MAX_HISTORY_TOKENS=4000
MEMORY_SUMMARY_THRESHOLD=20

# ========== 性能配置 ==========
REQUEST_TIMEOUT=60
MAX_RETRIES=3
RETRY_DELAY=1.0
MAX_CONCURRENT=10

# ========== 模型参数 ==========
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# ========== 剧本配置 ==========
MAX_SCRIPT_LENGTH=50000
MAX_EVENTS_PER_SCRIPT=500

# ========== 成本配置（JSON格式） ==========
COST_PER_1K_TOKENS={"deepseek-chat": 0.001, "gpt-3.5-turbo": 0.002, "gpt-4": 0.03}