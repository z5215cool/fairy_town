# 童话镇多智能体系统 - 环境变量配置

# ========== API配置 ==========
# DeepSeek API密钥（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your_api_key_here

# DeepSeek API地址（通常不需要修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 使用的模型（通常不需要修改）
DEEPSEEK_MODEL=deepseek-chat

# ========== 系统配置 ==========
# 调试模式（生产环境设为false）
DEBUG=true

# 日志级别
LOG_LEVEL=INFO

# 密钥（生产环境请修改）
SECRET_KEY=dev-secret-key-change-in-production

# ========== 记忆配置 ==========
# 默认记忆长度
DEFAULT_MEMORY_LEN=10

# 最大历史token数
MAX_HISTORY_TOKENS=4000

# 记忆摘要阈值
MEMORY_SUMMARY_THRESHOLD=20

# ========== 性能配置 ==========
# 请求超时时间（秒）
REQUEST_TIMEOUT=60

# 最大重试次数
MAX_RETRIES=3

# 重试延迟（秒）
RETRY_DELAY=1.0

# 最大并发数
MAX_CONCURRENT=10

# ========== 模型参数 ==========
# 默认温度
DEFAULT_TEMPERATURE=0.7

# 默认最大token数
DEFAULT_MAX_TOKENS=2000

# ========== 剧本配置 ==========
# 最大剧本长度
MAX_SCRIPT_LENGTH=50000

# 每剧本最大事件数
MAX_EVENTS_PER_SCRIPT=500