# ==================== DeepSeek AI 配置 ====================
# 在这里填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-smZ1ZDsOqBAYcM2YG_vbNw
# (可选) 如果你使用的是代理或私有部署，可以修改下面的地址
# 默认是: https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://xplt.sdu.edu.cn:4000

# (可选) 使用的模型名称，默认是 deepseek-chat
DEEPSEEK_MODEL=SDU-AI/DeepSeek-V4-Flash

# ==================== 系统调试配置 ====================
# 开启调试模式 (true/false)
DEBUG=true

# 日志级别 (INFO/DEBUG/WARNING/ERROR)
LOG_LEVEL=INFO

# ==================== 记忆与性能配置 (可选，保持默认即可) ====================
DEFAULT_MEMORY_LEN=10
MAX_HISTORY_TOKENS=4000
REQUEST_TIMEOUT=60