# ==================== DeepSeek AI 配置 ====================
# 在这里填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-31dad8c9df47471b8ad22a10a3e0286f
# (可选) 如果你使用的是代理或私有部署，可以修改下面的地址
# 默认是: https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# (可选) 使用的模型名称，默认是 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# ==================== 豆包 AI 配置 ====================
# 火山引擎方舟API Key（在方舟控制台API Key管理中获取）
ARK_API_KEY=ark-1cee974c-e577-4b3b-846b-43d3643223d1-fa964
# 豆包图片生成API地址（即梦模型）
DOUBAO_IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# 豆包图像生成模型
DOUBAO_IMAGE_MODEL=doubao-seedream-4-5-251128

# ==================== 系统调试配置 ====================
# 开启调试模式 (true/false)
DEBUG=true

# 日志级别 (INFO/DEBUG/WARNING/ERROR)
LOG_LEVEL=INFO

# ==================== 记忆与性能配置 (可选，保持默认即可) ====================
DEFAULT_MEMORY_LEN=10
MAX_HISTORY_TOKENS=4000
REQUEST_TIMEOUT=60
